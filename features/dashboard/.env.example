NEXT_PUBLIC_USE_MOCKS=1
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8000
# Public Mapbox token (pk.). Leave empty to use the free OpenFreeMap basemap.
NEXT_PUBLIC_MAPBOX_TOKEN=

